# Stable public deployment snapshot — kept locally as the v0.6.0 rollback
# reference and compare-before-release baseline, but not tracked in git.
published/

# Dependencies
node_modules/

# Local environment (keep documented examples trackable)
.env
.env.*
!.env.example
*.local

# Build and tool caches
workspace/dist/
workspace/qa-dist/
workspace/.vite/
*.tsbuildinfo

# Test and QA run artifacts
workspace/qa-evidence/
workspace/.playwright-cli/
workspace/output/
workspace/test-results/
workspace/playwright-report/
workspace/coverage/

# Standalone smoke files are regenerated by workspace/qa/export-smoke.js.
workspace/qa/standalone-*-smoke*.html
workspace/qa/standalone-*-runtime.js

# Targeted visual QA may add local-only captures beside curated release evidence.
# Existing tracked release evidence remains tracked and publishable.
workspace/public/review/*-evidence/**/*-stable.png
workspace/public/review/*-evidence/**/assisted-pilot.png
workspace/public/review/*-evidence/*interactions-standalone/

# Local agent/task notes
/progress.md

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
