{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "published-v0.6.0",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080",
        "--directory",
        "published"
      ],
      "port": 8080
    },
    {
      "name": "workspace-dist-v0.7.0",
      "cwd": "workspace",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "workspace-dev",
      "cwd": "workspace",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}
